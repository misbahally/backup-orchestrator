server {
    listen 80;
    server_name localhost;

    # resolver + variable so nginx resolves the upstream lazily per-request instead
    # of failing at startup ("host not found in upstream") when DNS isn't ready yet
    # or the hostname differs across environments (docker-compose vs ECS).
    resolver ${DNS_RESOLVER} valid=10s;

    location /api/ {
        set $api_upstream "http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT}";
        proxy_pass $api_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;

        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}
