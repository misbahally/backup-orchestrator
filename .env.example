# Postgres
POSTGRES_DB=backup_control
POSTGRES_USER=backup
POSTGRES_PASSWORD=backup
DATABASE_URL=postgresql+psycopg2://backup:backup@postgres:5432/backup_control

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8080
API_KEYS=
EXPOSE_DOCS=true

# Worker
MAX_RETRIES=3
RQ_JOB_TIMEOUT=2h
SCHEDULER_INTERVAL_SECONDS=60
RUN_STALE_GRACE_SECONDS=300
FILE_SOURCE_ALLOWED_ROOTS=/data:/mnt/backups
LOG_LEVEL=INFO
WORKER_METRICS_PORT=9090
SCHEDULER_METRICS_PORT=9090

# Web
API_BASE_URL=/api
